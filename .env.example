# =============================================
# REI Survey Template — Environment Variables
# Copy to .env.local for local development
# Set all of these in Vercel for production
# =============================================

# --- Brand ---
COMPANY_NAME="Your Home Buyers"
PHONE_DISPLAY="(800) 000-0000"
PHONE_HREF="8000000000"
ACCENT_COLOR="#2563eb"
LOGO_URL=""

# --- Hero Content ---
HEADLINE="Sell Your House Fast For Cash"
SUBHEADLINE="No fees. No repairs. Cash offer in 24 hours."

# --- Trust Indicators ---
STAT_1_VALUE="1,000+"
STAT_1_LABEL="Homes Purchased"
STAT_2_VALUE="10+"
STAT_2_LABEL="Years in Business"
STAT_3_VALUE="24 Hrs"
STAT_3_LABEL="Cash Offer"

# --- SEO ---
META_TITLE="Sell Your House Fast For Cash | Your Home Buyers"
META_DESCRIPTION="Get a fair cash offer for your home in 24 hours. No fees, no repairs, no hassle."

# --- Footer Links ---
PRIVACY_POLICY_URL="/privacy"
TERMS_URL="/terms"

# --- Survey disqualification (optional, comma-separated property type IDs) ---
# Valid IDs: single-family, multi-family, condo-townhouse, mobile-home, land, other
# DISQUALIFIED_PROPERTY_TYPES="mobile-home,land,other"

# --- Integrations (server-side, never exposed to browser) ---
WEBHOOK_URL=""
# GoFunnel external / custom-webhook credential for server-side lead forwarding.
# Per-client (set both in each deployment). Leave blank to disable the forward.
GOFUNNEL_WEBHOOK_CREDENTIAL_ID=""
GOFUNNEL_WEBHOOK_SECRET=""

# --- Client-side integrations (NEXT_PUBLIC_ prefix required) ---
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=""
# GoFunnel attribution tracking org (client) id. Per-client; blank disables tracking.
NEXT_PUBLIC_GOFUNNEL_ORG_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""
NEXT_PUBLIC_VIDALYTICS_ACCOUNT_ID=""
NEXT_PUBLIC_VIDALYTICS_EMBED_ID=""

# --- Thank You page video (leave blank to hide) ---
NEXT_PUBLIC_THANKYOU_VIDEO_URL=""

# =============================================
# Agent-Outreach Acquisition Pipeline
# (separate subsystem from the seller survey above — see lib/acquisition/README.md)
# Deliberately NOT in env-schema.json: these belong to one internal deployment, not
# to the per-client survey template the onboarding tool deploys.
# =============================================

# --- Endpoint auth (required; endpoint refuses all requests when unset) ---
ACQ_API_SECRET=""

# --- Vision classifier ---
ANTHROPIC_API_KEY=""
ACQ_VISION_ENABLED="true"
ACQ_VISION_MAX_PHOTOS="8"
ACQ_VISION_MODEL="claude-opus-5"

# --- Market filters ---
# Empty = statewide (the default). Narrow it to pilot a region. Regional cost
# differences are handled by lib/acquisition/regions.ts, not by this filter.
ACQ_ALLOWED_COUNTIES=""
ACQ_EXCLUDED_ZIPS=""
MAX_LIST_PRICE="750000"
MIN_LIST_PRICE="80000"
MIN_CONDITION_SCORE="45"

# --- Offer formula: offer = (ARV * multiplier) - repairs ---
OFFER_ARV_MULTIPLIER="0.75"

# --- Repair rates (CALIBRATE THESE — defaults are placeholders, not researched) ---
REPAIR_COSMETIC_PER_SQFT="18"
REPAIR_MODERATE_PER_SQFT="40"
REPAIR_HEAVY_PER_SQFT="70"
REPAIR_SEVERE_PER_SQFT="105"
REPAIR_CONTINGENCY_PCT="0.15"
REPAIR_ROOF_PER_SQFT="12"
REPAIR_HVAC_FLAT="9000"
FALLBACK_LIVING_AREA="1400"

# --- Auto-send gate ---
AUTO_SEND_ENABLED="false"
AUTO_SEND_MIN_CONFIDENCE="70"
MAX_AUTO_SENDS_PER_DAY="25"
MIN_OFFER_RATIO_OF_LIST="0.55"

# --- LOI content ---
LOI_BUYER_ENTITY=""
LOI_SIGNER_NAME=""
LOI_SIGNER_TITLE="Acquisitions"
LOI_REPLY_EMAIL=""
LOI_PHONE=""
LOI_EARNEST_MONEY="5000"
LOI_INSPECTION_DAYS="10"
LOI_CLOSING_DAYS="21"
LOI_VALID_DAYS="5"
# Florida licensee disclosure — set your license number to render the disclosure
# paragraph into every LOI (Fla. Stat. ch. 475 requires licensees buying for their
# own account to disclose licensed status in writing).
LOI_FL_LICENSE_NUMBER=""

# --- Email negotiation ---
# Master switch. When false, every inbound agent reply escalates to a human.
NEGOTIATION_ENABLED="false"
# Walk-away ceiling as a multiple of ARV, before repairs. The gap between this and
# OFFER_ARV_MULTIPLIER is your entire negotiating room.
NEGOTIATION_MAX_ARV_MULTIPLIER="0.80"
# Fraction of the remaining gap conceded per round. Length = max concessions.
NEGOTIATION_CONCESSION_STEPS="0.4,0.3,0.2"
